#!/usr/bin/env python3
"""Sync nusagate models in opencode.json from the live API + models.dev.

Updates per model: name prefix, capabilities.reasoning.effort (models.dev
consensus), cost (IDR -> USD at RATE), limit.context. Unknown models are
reported, never invented.
"""
import json, os, sys, urllib.request
from collections import Counter, OrderedDict

CONFIG = os.path.expanduser("~/.config/opencode/opencode.json")
RATE = 18000  # nusagate.com: "kurs Rp 18.000/USD"
PREFIX = "[NusaGate] "
OFFICIAL = {"deepseek": "deepseek", "gemini": "google", "glm": "zai", "gpt": "openai",
            "grok": "xai", "kimi": "moonshotai", "minimax": "minimax", "qwen": "alibaba"}


def get(url, key=None):
    h = {"User-Agent": "nusagate-sync/1"}
    if key:
        h["Authorization"] = f"Bearer {key}"
    with urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=30) as r:
        return json.load(r)


def efforts(mid, catalog):
    """Vendor entry wins (empty list = toggle-only, no effort). Consensus only
    when the vendor has no entry at all."""
    rows = []
    for pid, p in catalog.items():
        for name, m in (p.get("models") or {}).items():
            n = name.lower()
            if n == mid or n.endswith("/" + mid):
                eff = next((o for o in m.get("reasoning_options") or [] if o["type"] == "effort"), None)
                rows.append((pid, eff and eff["values"], m.get("reasoning_options")))
    vendor = next((r for r in rows if r[0] == OFFICIAL.get(mid.split("-")[0].split(".")[0])), None)
    if vendor:
        return vendor[1] or []
    lists = Counter(tuple(e) for _, e, _ in rows if e)
    return list(lists.most_common(1)[0][0]) if lists else None


def main():
    key = os.environ.get("NUSAGATE_API_KEY")
    if not key:  # non-interactive shells don't source ~/.zshrc
        env_file = os.path.expanduser("~/.config/secrets/nusagate.env")
        try:
            for line in open(env_file):
                line = line.strip().removeprefix("export ")
                if line.startswith("NUSAGATE_API_KEY="):
                    key = line.split("=", 1)[1].strip().strip("\"'")
                    break
        except OSError:
            pass
    if not key:  # legacy: exported in an rc file
        for rc in ("~/.zshrc", "~/.zshenv", "~/.bashrc", "~/.profile"):
            path = os.path.expanduser(rc)
            try:
                for line in open(path):
                    if line.strip().startswith("export NUSAGATE_API_KEY="):
                        key = line.split("=", 1)[1].strip().strip("\"'")
                        break
            except OSError:
                continue
            if key:
                break
    if not key:
        sys.exit("NUSAGATE_API_KEY not set (env, ~/.config/secrets/nusagate.env, or shell rc)")
    api = {m["id"]: m for m in get("https://api.nusagate.com/v1/models", key)["data"]}
    catalog = get("https://models.dev/api.json")
    cfg = json.load(open(CONFIG), object_pairs_hook=OrderedDict)
    models = cfg["providers"]["nusagate"]["models"]
    usd = lambda v: round(v / RATE, 4)
    unknown, changed = [], 0

    for mid, old in list(models.items()):
        a = api.get(mid)
        if not a:
            unknown.append(mid)
            continue
        pr = a["pricing"]
        new = OrderedDict()
        for k, v in old.items():
            if k == "cost":
                continue
            new[k] = v
            if k == "name":
                new[k] = PREFIX + v.removeprefix(PREFIX)
                eff = efforts(mid, catalog)
                if eff:
                    new["capabilities"] = {"reasoning": {"supported": True, "effort": eff}}
            if k == "limit":
                new[k] = {"context": a["contextLength"], "output": v["output"]}
                new["cost"] = {"input": usd(pr["inputPer1M"]), "output": usd(pr["outputPer1M"]),
                               "cache": {"read": usd(pr["cachePricePer1M"]),
                                         "write": usd(pr["cachePricePer1M"])}}
        if new != old:
            changed += 1
        models[mid] = new

    if changed:
        open(CONFIG, "w").write(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
    print(f"{len(models)} models, {changed} updated, rate Rp {RATE}/USD\n")
    rows = sorted(
        (mid, f"${m['cost']['input']}", f"${m['cost']['output']}", f"${m['cost']['cache']['read']}",
         ", ".join(m.get("capabilities", {}).get("reasoning", {}).get("effort", [])) or "—")
        for mid, m in models.items())
    head = ["Model", "Input $/1M", "Output $/1M", "Cache read $/1M", "Reasoning effort"]
    align = ["---", "---:", "---:", "---:", "---"]
    print("| " + " | ".join(head) + " |")
    print("| " + " | ".join(align) + " |")
    for r in rows:
        print("| " + " | ".join(str(v) for v in r) + " |")
    if unknown:
        print("\n⚠️ not on API (left as-is): " + ", ".join(unknown))


if __name__ == "__main__":
    main()
