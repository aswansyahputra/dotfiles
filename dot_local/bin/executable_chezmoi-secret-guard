#!/bin/sh
# chezmoi git-auto-commit pre-hook: block commits that contain credentials.
#
# Runs after `git add .`, before `git commit`, so it sees exactly what would be
# committed. On a match it:
#   1. removes the offending files from the index, and
#   2. deletes the source copies (the $HOME targets are left untouched),
# so the secret cannot ride along in the *next* auto-commit either.
# Exits non-zero so chezmoi aborts the commit.

set -u

PATTERN='sk-[A-Za-z0-9]{16}|nsk_[A-Za-z0-9]{8}|ghp_[A-Za-z0-9]{20}|github_pat_[A-Za-z0-9_]{20}|AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY|(api[_-]?key|secret|token|password)[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_/+-]{16}'

src=${CHEZMOI_SOURCE_DIR:?CHEZMOI_SOURCE_DIR not set}
cd "$src" || exit 0

bad=$(git diff --cached --name-only -G"$PATTERN" 2>/dev/null)
[ -z "$bad" ] && exit 0

echo "BLOCKED: credential pattern found in staged changes:" >&2
printf '  %s\n' $bad >&2

printf '%s\n' $bad | while IFS= read -r f; do
    git reset -q HEAD -- "$f" 2>/dev/null || true
    rm -f -- "$f"
    echo "  unstaged and deleted from source: $f" >&2
done

echo "The \$HOME file was not touched. Nothing was committed." >&2
echo "Fix or remove the credential, then re-run the chezmoi command." >&2
exit 1
