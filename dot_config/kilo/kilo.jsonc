{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "curl *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "echo *": "allow",
      "gh pr checks *": "allow",
      "gh pr close *": "allow",
      "gh pr create *": "allow",
      "gh pr view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh secret list *": "allow",
      "gh variable list *": "allow",
      "git add *": "allow",
      "git branch *": "allow",
      "git check-ignore *": "allow",
      "git checkout *": "allow",
      "git cherry *": "allow",
      "git cherry-pick *": "allow",
      "git commit *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git merge *": "allow",
      "git pull *": "allow",
      "git push *": "allow",
      "git remote -v *": "allow",
      "git rev-parse *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "man *": "allow",
      "mkdir *": "allow",
      "node *": "allow",
      "npm -v *": "allow",
      "npm run build *": "allow",
      "npm run format *": "allow",
      "npm run format:check *": "allow",
      "npm run lint *": "allow",
      "npm test *": "allow",
      "npx *": "allow",
      "printenv *": "allow",
      "ps *": "allow",
      "pwd *": "allow",
      "rg *": "allow",
      "Rscript *": "allow",
      "rtk *": "allow",
      "sed *": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "type *": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami *": "allow",
      "git show *": "allow",
      "git -c *": "allow",
      "NOT_CRAN=true *": "allow",
      "perl *": "allow",
      "git ls-remote *": "allow",
      "gh pr list *": "allow",
      "git rev-list *": "allow",
    },
    "kilo_memory_recall": {
      "*": "allow",
    },
    "repl-r_repl": {
      "*": "allow",
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
    },
    "edit": {
      "*": "allow",
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "ask",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask",
    "codesearch": "allow",
  },
  "mcp": {
    "repl-python": {
      "type": "local",
      "command": ["/Users/aswansyahputra/.local/bin/mcp-repl"],
      "args": [
        "--sandbox",
        "workspace-write",
        "--oversized-output",
        "files",
        "--interpreter",
        "python",
      ],
      "enabled": true,
    },
    "repl-r": {
      "type": "local",
      "command": ["/Users/aswansyahputra/.local/bin/mcp-repl"],
      "args": [
        "--sandbox",
        "workspace-write",
        "--oversized-output",
        "files",
        "--interpreter",
        "r",
      ],
      "enabled": true,
    },
    "firebase": {
      "type": "local",
      "command": ["npx", "-y", "firebase-tools@latest", "mcp"],
      "enabled": true,
    },
  },
  "plugin": ["opencode-mermaid-renderer"],
  "privacy_mode": true,
  "disabled_providers": [],
  "hide_prompt_training_models": true,
}
